#Requires AutoHotkey v2.0

; ==============================================================================
; [AZIK] 日本語入力カスタム
; - JISコロンキー (vkBA): 日本語入力中なら長音 (ー) を入力
;   英語入力中なら通常のコロン (:) を入力
; ==============================================================================

$vkBA::
{
    if (IME_IsON()) {
        SendText("ー")
    } else {
        Send("{Blind}{vkBA}")
    }
}
