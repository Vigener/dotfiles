// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "option_as_meta": true,
  },
  "minimap": {
    "show": "never",
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {},
  "collaboration_panel": {},
  "agent": {
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
    },
    "dock": "right",
    "sidebar_side": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "autosave": "on_focus_change",
  "languages": {
    "C": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["-style={BasedOnStyle: LLVM, IndentWidth: 4}"],
        },
      },
    },
  },
  "lsp": {
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$root/$dir/$name",
      },
    },
  },
}
