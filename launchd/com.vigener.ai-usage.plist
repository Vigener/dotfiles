<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vigener.ai-usage</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-l</string>
        <string>-c</string>
        <string>if [[ -x "$HOME/dotfiles/bin/update-ai-usage" ]]; then "$HOME/dotfiles/bin/update-ai-usage"; elif [[ -x "$HOME/.local/bin/update-ai-usage" ]]; then "$HOME/.local/bin/update-ai-usage"; fi</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/mikoto/.local/bin:/Users/mikoto/bin</string>
        <key>HOME</key>
        <string>/Users/mikoto</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.vigener.ai-usage.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.vigener.ai-usage.stderr.log</string>
</dict>
</plist>
