#!/usr/bin/env bash
set -euo pipefail

OWNER="${GITHUB_MIRROR_OWNER:-Vigener}"
BASE="${GITHUB_MIRROR_DIR:-$HOME/backups/github.com/$OWNER}"
IGNORE_FILE="$BASE/.ignore-repos"
NTFY_BIN="${NTFY_BIN:-$HOME/dotfiles/bin/ntfy-notify}"

mkdir -p "$BASE"

notify_failure() {
  local msg="$1"
  if [[ -x "$NTFY_BIN" ]]; then
    "$NTFY_BIN" "GitHub mirror failed" "$msg" || true
  fi
}

failures=()
newly_cloned=()

# Build ignore lookup (strip comments & blank lines)
is_ignored() {
  local target="$1"
  [[ -f "$IGNORE_FILE" ]] || return 1
  grep -qxF "$target" <(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$IGNORE_FILE")
}

# 1. Discover new non-fork, non-archived repositories and auto-mirror them
if repos_json=$(gh repo list "$OWNER" --source --no-archived --limit 200 --json name --jq '.[].name' 2>&1); then
  while IFS= read -r repo; do
    [[ -z "$repo" ]] && continue
    if is_ignored "$repo"; then
      continue
    fi
    dest="$BASE/$repo.git"
    if [[ ! -d "$dest" ]]; then
      echo "==> New repository detected: $repo (cloning mirror)"
      if git clone --mirror "git@github.com:$OWNER/$repo.git" "$dest"; then
        newly_cloned+=("$repo")
      else
        failures+=("clone:$repo")
      fi
    fi
  done <<< "$repos_json"
else
  echo "error: gh repo list failed: $repos_json" >&2
  failures+=("gh-repo-list")
fi

# 2. Update all existing mirrors (without --prune so deleted remote refs are retained locally)
for repo_dir in "$BASE"/*.git; do
  [[ -d "$repo_dir" ]] || continue
  name="$(basename "$repo_dir" .git)"
  echo "==> Updating $name.git"
  if ! git -C "$repo_dir" remote update; then
    failures+=("update:$name")
  fi
done

echo "Done at $(date '+%Y-%m-%d %H:%M:%S'). Total size: $(du -sh "$BASE" | cut -f1)"
if (( ${#newly_cloned[@]} > 0 )); then
  echo "Newly added mirrors: ${newly_cloned[*]}"
fi

if (( ${#failures[@]} > 0 )); then
  err_msg="Failed steps: ${failures[*]}"
  echo "ERROR: $err_msg" >&2
  notify_failure "$err_msg"
  exit 1
fi
