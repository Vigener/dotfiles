#!/usr/bin/env node
/**
 * dsh-sub: call `dsh --profile headless` as an orchestrator-friendly subagent.
 *
 * Wraps the NDJSON event stream in one line of JSON and normalizes exit codes,
 * so callers only need to check `ok`.
 *
 * Usage:
 *   dsh-sub --repo <dir> --prompt <text|-> [options]
 *
 * Options:
 *   --repo <dir>        workspace root (required; becomes the child cwd)
 *   --prompt <text|->   task text; `-` reads stdin
 *   --session <id>      resume an existing session id
 *   --model <id>        model id (default: profile default, deepseek-flash)
 *   --provider <id>     provider route (default: deepseek-official)
 *   --effort <level>    off | low | high | max (default: inherit profile;
 *                       high when --model/--effort generates an overlay)
 *   --timeout <sec>     wall-clock limit (default: 900)
 *   --danger            DSH_PERMISSION_MODE=danger-full-access
 *   --no-telemetry      disable OTel export and DeepSeek session-log upload
 *   --keep-raw <path>   also write the raw NDJSON stream to <path>
 *   -h, --help          show this help
 *
 * Exit codes: 0 ok / 2 usage / 3 run failed / 4 timeout / 5 contract violation
 */

'use strict'

const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')
const { spawn } = require('node:child_process')
const readline = require('node:readline')

const EXIT = { ok: 0, usage: 2, failed: 3, timeout: 4, contract: 5 }
const RETRYABLE = new Set([
  'RATE_LIMIT', 'TIMEOUT', 'TRANSPORT', 'SERVER', 'EMPTY_RESPONSE',
])

function fail(message, code = EXIT.usage) {
  process.stderr.write(`dsh-sub: ${message}\n`)
  process.stdout.write(JSON.stringify({ ok: false, code: 'USAGE', message }) + '\n')
  process.exit(code)
}

function parseArgs(argv) {
  const out = { provider: 'deepseek-official', timeout: 900 }
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i]
    const next = () => {
      const value = argv[i + 1]
      if (value === undefined) fail(`${arg} requires a value`)
      i += 1
      return value
    }
    switch (arg) {
      case '--repo': out.repo = next(); break
      case '--prompt': out.prompt = next(); break
      case '--session': out.session = next(); break
      case '--model': out.model = next(); break
      case '--provider': out.provider = next(); break
      case '--effort': out.effort = next(); break
      case '--timeout': out.timeout = Number(next()); break
      case '--danger': out.danger = true; break
      case '--no-telemetry': out.noTelemetry = true; break
      case '--keep-raw': out.keepRaw = next(); break
      case '-h': case '--help': out.help = true; break
      default:
        if (arg.startsWith('--')) fail(`unknown option: ${arg}`)
        fail(`unexpected argument: ${arg}`)
    }
  }
  return out
}

const HELP = `Usage: dsh-sub --repo <dir> --prompt <text|-> [options]

  --repo <dir>        workspace root (required)
  --prompt <text|->   task text; '-' reads stdin
  --session <id>      resume an existing session id
  --model <id>        model id (default: profile default, deepseek-flash)
  --provider <id>     provider route (default: deepseek-official)
  --effort <level>    off | low | high | max (default: inherit profile;
                      high when --model/--effort generates an overlay)
  --timeout <sec>     wall-clock limit (default: 900)
  --danger            DSH_PERMISSION_MODE=danger-full-access
  --no-telemetry      disable OTel export and DeepSeek session-log upload
  --keep-raw <path>   also write the raw NDJSON stream to <path>
  -h, --help          show this help

Prints one JSON line on stdout:
  {"ok":true,"sessionId":"...","text":"...","usage":{...},"ms":3300}
`

function readStdin() {
  return new Promise((resolve, reject) => {
    let data = ''
    process.stdin.setEncoding('utf8')
    process.stdin.on('data', (chunk) => { data += chunk })
    process.stdin.on('end', () => resolve(data))
    process.stdin.on('error', reject)
  })
}

function createOverlay(files, rows) {
  const file = path.join(files, `overlay-${rows.length}.yml`)
  fs.writeFileSync(file, rows, { mode: 0o600 })
  return file
}

async function main() {
  const opts = parseArgs(process.argv.slice(2))
  if (opts.help) { process.stdout.write(HELP); process.exit(EXIT.ok) }

  if (!opts.repo) fail('--repo is required')
  if (opts.prompt === undefined) fail('--prompt is required')

  const repo = path.resolve(opts.repo)
  let stat
  try { stat = fs.statSync(repo) } catch { fail(`--repo does not exist: ${repo}`) }
  if (!stat.isDirectory()) fail(`--repo is not a directory: ${repo}`)

  if (opts.effort !== undefined && !['off', 'low', 'high', 'max'].includes(opts.effort)) {
    fail(`--effort must be off, low, high, or max: ${opts.effort}`)
  }
  if (!Number.isFinite(opts.timeout) || opts.timeout <= 0) {
    fail(`--timeout must be a positive number of seconds: ${opts.timeout}`)
  }

  let task = opts.prompt
  if (task === '-') {
    if (process.stdin.isTTY) fail('--prompt - expects piped stdin')
    task = await readStdin()
    if (!task.trim()) fail('stdin was empty')
  } else if (!task.trim()) {
    fail('--prompt was blank')
  }

  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'dsh-sub-'))
  const patches = []
  if (opts.model || opts.effort !== undefined) {
    const rows = [
      '- id: agent-default-model',
      '  config:',
      `    provider: ${opts.provider}`,
      `    model: ${opts.model ?? 'deepseek-flash'}`,
      `    reasoningEffort: ${opts.effort ?? 'high'}`,
      '',
    ].join('\n')
    patches.push(createOverlay(tmp, rows))
  }
  if (opts.noTelemetry) {
    const rows = [
      '- id: session-telemetry-otel',
      '  disabled: true',
      '- id: session-log-deepseek',
      '  disabled: true',
      '',
    ].join('\n')
    patches.push(createOverlay(tmp, rows))
  }

  const args = ['--profile', 'headless']
  for (const patch of patches) args.push('--patch', patch)
  args.push('--json')
  if (opts.session) args.push('--session-id', opts.session)

  const env = { ...process.env }
  if (opts.danger) env.DSH_PERMISSION_MODE = 'danger-full-access'

  const started = Date.now()
  const child = spawn('dsh', args, {
    cwd: repo,
    env,
    stdio: ['pipe', 'pipe', 'pipe'],
    detached: true,
  })

  const state = {
    sessionId: null, cwd: repo, text: '', reason: null, error: null,
    usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
    calls: 0, denied: 0, stderr: '', timedOut: false, spawnError: null,
  }

  const rawStream = opts.keepRaw ? fs.createWriteStream(opts.keepRaw) : null
  const rl = readline.createInterface({ input: child.stdout })

  rl.on('line', (line) => {
    if (rawStream) rawStream.write(line + '\n')
    let event
    try { event = JSON.parse(line) } catch { return }
    switch (event.type) {
      case 'session':
        state.sessionId = event.sessionId ?? state.sessionId
        state.cwd = event.cwd ?? state.cwd
        break
      case 'status':
        if (event.phase === 'step_end' && event.usage) {
          state.usage.input += event.usage.inputTokens ?? 0
          state.usage.output += event.usage.outputTokens ?? 0
          state.usage.cacheRead += event.usage.cacheReadTokens ?? 0
          state.usage.cacheWrite += event.usage.cacheWriteTokens ?? 0
        }
        if (event.phase === 'turn_end') {
          state.reason = event.reason ?? null
          if (event.reason?.kind === 'error') state.error = event.reason.error ?? null
        }
        break
      case 'tool_call':
        state.calls += 1
        break
      case 'tool_result':
        if (event.status && event.status !== 'completed') state.denied += 1
        break
      case 'final':
        state.text = event.text ?? ''
        break
      default:
        break
    }
  })

  child.stderr.on('data', (chunk) => {
    state.stderr += chunk.toString()
    if (state.stderr.length > 16384) state.stderr = state.stderr.slice(-16384)
  })

  child.on('error', (err) => { state.spawnError = err })

  const timer = setTimeout(() => {
    state.timedOut = true
    killTree('SIGTERM')
    setTimeout(() => killTree('SIGKILL'), 5000).unref()
  }, opts.timeout * 1000)

  function killTree(signal) {
    if (!child.pid) return
    try { process.kill(-child.pid, signal) } catch {
      try { child.kill(signal) } catch { /* already gone */ }
    }
  }

  child.stdin.on('error', () => {})
  child.stdin.end(task)

  const exitCode = await new Promise((resolve) => {
    let settled = false
    const finish = (code) => {
      if (settled) return
      settled = true
      resolve(code ?? -1)
    }
    child.on('close', (code) => finish(code))
    child.on('exit', (code) => {
      // A killed tree can leave descendants holding the pipes open; drain briefly, then force-close.
      setTimeout(() => {
        child.stdout.destroy()
        child.stderr.destroy()
        finish(code)
      }, 200).unref()
    })
  })
  clearTimeout(timer)
  if (rawStream) rawStream.end()
  fs.rmSync(tmp, { recursive: true, force: true })

  const ms = Date.now() - started
  const usage = {
    input: state.usage.input, output: state.usage.output,
    cacheRead: state.usage.cacheRead, cacheWrite: state.usage.cacheWrite,
    total: state.usage.input + state.usage.output + state.usage.cacheRead + state.usage.cacheWrite,
  }

  let code = state.error?.code ?? null
  let message = state.error?.message ?? null
  if (!code) {
    const match = state.stderr.match(/^dsh: ([A-Z][A-Z0-9_]*): (.*)$/m)
    if (match) { code = match[1]; message = match[2] }
  }

  if (state.spawnError) {
    code = state.spawnError.code === 'ENOENT' ? 'DSH_NOT_FOUND' : 'SPAWN_FAILED'
    message = state.spawnError.message
  } else if (state.timedOut) {
    code = 'TIMEOUT'
    message = `exceeded --timeout ${opts.timeout}s`
  } else if (!code && exitCode === 0 && !state.text.trim()) {
    code = 'EMPTY_FINAL'
    message = 'dsh exited 0 but produced no final text'
  } else if (!code && exitCode !== 0) {
    code = 'RUN_FAILED'
    message = (state.stderr.trim().split('\n').pop() || `dsh exited ${exitCode}`)
  }

  const ok = !code && exitCode === 0 && Boolean(state.text.trim())
  const result = {
    ok,
    sessionId: state.sessionId,
    cwd: state.cwd,
    text: state.text,
    usage,
    tools: { calls: state.calls, denied: state.denied },
    ms,
  }
  if (!ok) {
    result.code = code ?? 'RUN_FAILED'
    result.message = message ?? 'unknown failure'
    result.retryable = RETRYABLE.has(result.code)
    result.exitCode = exitCode
  }

  process.stdout.write(JSON.stringify(result) + '\n')
  process.exit(ok ? EXIT.ok : (state.timedOut ? EXIT.timeout : (code === 'EMPTY_FINAL' ? EXIT.contract : EXIT.failed)))
}

main().catch((err) => {
  process.stderr.write(`dsh-sub: ${err?.stack ?? err}\n`)
  process.stdout.write(JSON.stringify({ ok: false, code: 'INTERNAL', message: String(err?.message ?? err) }) + '\n')
  process.exit(EXIT.failed)
})
