HTML_TEMPLATE = """<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,400;7..72,600;7..72,700&family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  <style>
    :root {{
      --bg: {bg};
      --paper: {paper};
      --paper-card: {paper_card};
      --ink: {ink};
      --muted: {muted};
      --accent: {accent};
      --teal: {teal};
      --warn: {warn};
      --line: {line};
      --font-body: {font_body};
      --serif: {serif};
      --mono: {mono};
    }}
    * {{ box-sizing: border-box; margin: 0; padding: 0; }}
    body {{
      font-family: var(--font-body);
      background: {radial}, var(--bg);
      color: var(--ink);
      line-height: 1.8;
      padding: 2.2rem 1.25rem 5rem;
    }}
    .wrap {{ max-width: 940px; margin: 0 auto; }}
    .eyebrow {{
      font-family: var(--mono); font-size: .75rem; letter-spacing: .08em;
      text-transform: uppercase; color: var(--accent); margin-bottom: .5rem;
    }}
    h1 {{
      font-family: var(--serif);
      font-size: clamp(1.45rem, 3.8vw, 2.05rem);
      font-weight: 700; line-height: 1.35; margin-bottom: .75rem; color: var(--ink);
    }}
    .meta-bar {{
      font-family: var(--mono); font-size: .8rem; color: var(--muted);
      border-bottom: 1px solid var(--line); padding-bottom: .9rem; margin-bottom: 2rem;
      display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center;
    }}
    .nav-links {{ display: flex; gap: .5rem; flex-wrap: wrap; }}
    .btn-nav {{
      background: rgba(128,128,128,.1); border: 1px solid var(--line);
      color: var(--accent); padding: .3rem .65rem; border-radius: 6px;
      text-decoration: none; font-family: var(--mono); font-size: .78rem;
      display: inline-flex; align-items: center; gap: .3rem; transition: all .15s;
    }}
    .btn-nav:hover {{ background: rgba(128,128,128,.2); border-color: var(--accent); }}

    /* Markdown Core Elements */
    #content {{ margin-top: 1rem; }}
    #content h1:first-child {{ display: none; }} /* Already shown in header */
    #content h2 {{
      font-size: 1.25rem; margin: 2.5rem 0 .8rem; color: var(--accent);
      border-bottom: 1px solid var(--line); padding-bottom: .45rem; display: flex; align-items: center; gap: .5rem;
    }}
    #content h3 {{
      font-size: 1.1rem; margin: 1.6rem 0 .5rem; color: var(--teal);
    }}
    #content h4 {{
      font-size: .95rem; margin: 1.2rem 0 .4rem; color: var(--ink);
    }}
    #content p {{ margin-bottom: 1.1rem; }}
    #content ul, #content ol {{ margin: 0 0 1.2rem 1.4rem; }}
    #content li {{ margin-bottom: .35rem; }}
    #content strong {{ color: var(--ink); font-weight: 700; }}
    
    /* Code & Terminal Styling */
    #content pre {{
      background: var(--paper); border: 1px solid var(--line); border-radius: 8px;
      padding: .9rem 1.1rem; overflow-x: auto; margin: 1.2rem 0; font-family: var(--mono); font-size: .85rem;
      line-height: 1.6;
    }}
    #content code {{
      font-family: var(--mono); font-size: .88em; background: rgba(128,128,128,.15);
      padding: .15em .4em; border-radius: 4px; color: var(--accent);
    }}
    #content pre code {{ background: none; padding: 0; color: inherit; }}

    /* Speech Bubble / Quote Blocks */
    #content blockquote {{
      background: var(--paper);
      border-left: 4px solid var(--accent);
      border-radius: 0 8px 8px 0;
      padding: .85rem 1.15rem;
      margin: 1.2rem 0;
      color: var(--ink);
    }}
    #content blockquote p:last-child {{ margin-bottom: 0; }}

    /* Responsive Tables */
    #content table {{
      width: 100%; border-collapse: collapse; margin: 1.4rem 0;
      background: var(--paper); border: 1px solid var(--line); border-radius: 8px; overflow: hidden;
      font-size: .88rem;
    }}
    #content th, #content td {{
      padding: .75rem 1rem; text-align: left; border-bottom: 1px solid var(--line);
    }}
    #content th {{
      background: var(--paper-card); color: var(--accent); font-family: var(--mono); font-size: .82rem;
    }}
    #content tr:last-child td {{ border-bottom: none; }}

    /* HR */
    #content hr {{
      border: none; border-top: 1px dashed var(--line); margin: 2.4rem 0;
    }}

    /* Checkbox list */
    #content input[type="checkbox"] {{
      margin-right: .5rem; accent-color: var(--accent);
    }}

    /* Print Stylesheet (A4 paper clipboard ready) */
    @media print {{
      body {{ background: #fff !important; color: #111 !important; padding: 0 !important; }}
      .wrap {{ max-width: 100% !important; margin: 0 !important; }}
      .meta-bar .nav-links, .eyebrow {{ display: none !important; }}
      #content h2 {{ color: #000 !important; border-color: #ccc !important; }}
      #content h3 {{ color: #222 !important; }}
      #content blockquote {{ background: #f5f5f5 !important; color: #000 !important; border-left-color: #333 !important; }}
      #content table {{ background: #fff !important; border-color: #ccc !important; }}
      #content th {{ background: #eee !important; color: #000 !important; }}
      #content td {{ border-color: #ccc !important; color: #000 !important; }}
      #content pre {{ background: #f8f8f8 !important; color: #111 !important; border-color: #ccc !important; }}
      .foot {{ display: none !important; }}
    }}

    .foot {{
      margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
      font-family: var(--mono); font-size: .8rem; color: var(--muted);
    }}
  </style>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
  <div class="wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.6rem;flex-wrap:wrap;gap:.5rem;">
      <p class="eyebrow">{eyebrow}</p>
      <div class="nav-links">
        <a href="javascript:window.print()" class="btn-nav">🖨️ A4印刷 / PDF</a>
      </div>
    </div>

    <h1>{title}</h1>
    <div class="meta-bar">
      <span>正本: <code>{src_filename}</code></span>
      <span>出力: <code>{dst_filename}</code></span>
    </div>

    <!-- Rendered Content Container -->
    <main id="content">
      <p class="muted">Loading content from markdown source...</p>
    </main>

    <div class="foot">
      <span>Generated by md-to-html (dotfiles)</span>
      <span>Source: {src_relpath}</span>
    </div>
  </div>

  <!-- Raw Markdown Data -->
  <script id="md-source" type="text/markdown">
{markdown_raw}
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {{
      const raw = document.getElementById("md-source").textContent;
      if (window.marked && raw) {{
        marked.setOptions({{
          gfm: true,
          breaks: true
        }});
        document.getElementById("content").innerHTML = marked.parse(raw);
      }}
    }});
  </script>
</body>
</html>
"""


def extract_title_and_eyebrow(md_text: str, default_title: str) -> tuple[str, str]:
    title = default_title
    eyebrow = "Document · Knowledge Base"
    
    # 1. Search for first # Header
    m_h1 = re.search(r"^#\s+(.+)$", md_text, flags=re.MULTILINE)
    if m_h1:
        title = m_h1.group(1).strip()
    
    # 2. Check for hints in text
    lower = md_text.lower()
    if "seminar" in lower or "就活" in lower or "面接" in lower or "インターン" in lower:
        eyebrow = "Career & Application · Tactical Sheet"
    elif "雑談" in lower or "幸福" in lower or "生活" in lower or "パートナー" in lower:
        eyebrow = "Life Events & Communication · Protocol"
    elif "finance" in lower or "資産" in lower or "sim" in lower:
        eyebrow = "Finance & Life Planning"

    return title, eyebrow


def auto_detect_theme(md_text: str) -> str:
    lower = md_text.lower()
    if "雑談" in lower or "幸福" in lower or "アジェンダ" in lower or "生活" in lower:
        return "sepia"
    if "seminar" in lower or "ヒアリング" in lower or "タイムキープ" in lower or "逆質問" in lower:
        return "tactical"
    return "tactical"



def open_in_browser(target_path: Path):
    """Open target in browser, ALWAYS prioritizing MBA via ssh, falling back to local."""
    target_str = str(target_path)
    url = None
    try:
        ts_ip = subprocess.check_output(["tailscale", "ip", "-4"], text=True, timeout=2).strip().splitlines()[0]
        p_str = str(target_path.resolve())
        if "/life-brain/" in p_str:
            rel = p_str.split("/life-brain/", 1)[1]
            url = f"http://{ts_ip}:8770/{rel}"
        elif "/research-brain/" in p_str:
            rel = p_str.split("/research-brain/", 1)[1]
            url = f"http://{ts_ip}:8766/{rel}"
        elif "/hybrid-workflow-sandbox/" in p_str:
            rel = p_str.split("/hybrid-workflow-sandbox/", 1)[1]
            url = f"http://{ts_ip}:8765/{rel}"
    except Exception:
        pass

    dest = url or target_str

    # Prioritize MBA via ssh
    res = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "mba", f"open '{dest}'"],
        capture_output=True,
    )
    if res.returncode == 0:
        print(f"Opened on MBA: {dest}")
        return

    # Fallback to local open
    print("ssh mba failed or unreachable. Falling back to local open...")
    if sys.platform == "darwin":
        subprocess.run(["open", target_str])
    elif os.name == "posix":
        subprocess.run(["xdg-open", target_str])


def compile_markdown_to_html(
    src_path: Path,
    dst_path: Path | None = None,
    theme_name: str = "auto",
    custom_title: str | None = None,
    open_browser: bool = False,
) -> Path:
    if not src_path.exists():
        raise FileNotFoundError(f"Source file not found: {src_path}")
    
    if dst_path is None:
        dst_path = src_path.with_suffix(".html")
        
    md_text = src_path.read_text(encoding="utf-8")
    title, eyebrow = extract_title_and_eyebrow(md_text, default_title=src_path.stem)
    if custom_title:
        title = custom_title

    if theme_name == "auto" or theme_name not in THEMES:
        theme_name = auto_detect_theme(md_text)
    
    theme_cfg = THEMES[theme_name]
    safe_md = md_text.replace("</script>", "<\\/script>")

    html_content = HTML_TEMPLATE.format(
        title=title,
        eyebrow=eyebrow,
        src_filename=src_path.name,
        dst_filename=dst_path.name,
        src_relpath=src_path.name,
        markdown_raw=safe_md,
        **theme_cfg,
    )
    
    dst_path.write_text(html_content, encoding="utf-8")
    print(f"Generated ({theme_name}): {dst_path}")
    
    if open_browser:
        open_in_browser(dst_path)
            
    return dst_path


def main():
    parser = argparse.ArgumentParser(
        description="Compile any Markdown into a standalone, print-ready, responsive HTML."
    )
    parser.add_argument("input", help="Path to input Markdown file (.md)")
    parser.add_argument("-o", "--output", help="Path to output HTML file (.html)")
    parser.add_argument(
        "-t",
        "--theme",
        choices=["auto", "tactical", "sepia", "minimal"],
        default="auto",
        help="Visual theme (default: auto detect based on content)",
    )
    parser.add_argument("--title", help="Custom page title")
    parser.add_argument("--open", action="store_true", help="Open generated HTML in browser")

    args = parser.parse_args()
    src = Path(args.input).resolve()
    dst = Path(args.output).resolve() if args.output else None

    compile_markdown_to_html(
        src_path=src,
        dst_path=dst,
        theme_name=args.theme,
        custom_title=args.title,
        open_browser=args.open,
    )


if __name__ == "__main__":
    main()
