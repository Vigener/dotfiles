  <!-- MathJax Configuration & Loader -->
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\\\(', '\\\\)']],
        displayMath: [['$$', '$$'], ['\\\\[', '\\\\]']],
        processEscapes: true
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
      }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
</head>
<body>
  <div class="layout-container">
    <div class="wrap">
    <div class="header-bar">
      <p class="eyebrow">__EYEBROW__</p>
      <div class="nav-links">
        <button type="button" onclick="window.print()" class="btn-nav">🖨️ A4印刷 / PDF</button>
      </div>
    </div>

    <h1 class="page-title">__TITLE__</h1>
    <div class="meta-bar">
      <span>正本: <code>__SRC_FILENAME__</code></span>
      <span>出力: <code>__DST_FILENAME__</code></span>
    </div>

    <!-- Rendered Content Container -->
    <main id="content" class="__CONTENT_CLASS__">
      <p class="muted">Loading content from markdown source...</p>
    </main>

    <div class="foot">
      <span>Generated by md-to-html (dotfiles)</span>
      <span>Source: __SRC_RELPATH__</span>
    </div>
  </div>

  <aside class="toc-sidebar" id="toc-sidebar" aria-label="Table of Contents">
    <div class="toc-title"><span>📑 目次</span></div>
    <nav id="toc-nav"></nav>
  </aside>
  </div>

  <!-- Raw Markdown Data -->
  <script id="md-source" type="text/markdown">
__MARKDOWN_RAW__
  </script>

  <script>
    // 1. Math Protection (Unicode PUA avoids marked interpreting '_' or '*' inside TeX)
    function protectMath(md) {
      const store = [];
      const stash = (match) => {
        const id = store.length;
        store.push(match);
        return "\\uE000MATH" + id + "\\uE001";
      };
      md = md.replace(/\\$\\$[\\s\\S]+?\\$\\$/g, stash);
      md = md.replace(/\\\\\\[[\\s\\S]+?\\\\\\]/g, stash);
      md = md.replace(/\\\\\\([\\s\\S]+?\\\\\\)/g, stash);
      md = md.replace(/(?<!\\$)\\$(?!\\$)[^$\\n]+?\\$/g, stash);
      return { md, store };
    }

    const MATH_COPY_ICON = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

    function escapeTextarea(text) {
      return text.replace(/<\\/textarea/gi, "<\\\\/textarea");
    }

    function wrapDisplayMathBlock(tex, innerLatex) {
      const safe = escapeTextarea(innerLatex);
      return (
        '<div class="math-block-wrap">' +
        '<button type="button" class="math-copy-btn" aria-label="LaTeX をコピー" title="LaTeX をコピー">' +
        MATH_COPY_ICON +
        '</button>' +
        '<textarea class="math-latex-source" readonly aria-hidden="true" tabindex="-1">' +
        safe +
        '</textarea>' +
        '<div class="math-block-body">' +
        tex +
        '</div></div>'
      );
    }

    function restoreMath(html, store) {
      return html.replace(/\\uE000MATH(\\d+)\\uE001/g, (_, i) => {
        const tex = store[Number(i)];
        const trimmed = tex.trim();
        if (/^\\$\\$[\\s\\S]+\\$\\$$/.test(trimmed)) {
          const inner = trimmed.slice(2, -2).trim();
          return wrapDisplayMathBlock(tex, inner);
        }
        if (/^\\\\\\[[\\s\\S]+\\\\\\]$/.test(trimmed)) {
          const inner = trimmed.slice(2, -2).trim();
          return wrapDisplayMathBlock(tex, inner);
        }
        return tex;
      });
    }

    function bindMathCopyButtons(root) {
      root.addEventListener("click", (e) => {
        const btn = e.target.closest(".math-copy-btn");
        if (!btn || !root.contains(btn)) return;
        const wrap = btn.closest(".math-block-wrap");
        const src = wrap && wrap.querySelector(".math-latex-source");
        if (!src) return;
        const text = src.value;
        const onCopied = () => {
          btn.classList.add("copied");
          const prev = btn.getAttribute("title");
          btn.setAttribute("title", "コピーしました");
          window.setTimeout(() => {
            btn.classList.remove("copied");
            if (prev) btn.setAttribute("title", prev);
          }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(onCopied).catch(() => {
            src.select();
            document.execCommand("copy");
            onCopied();
          });
        } else {
          src.select();
          document.execCommand("copy");
          onCopied();
        }
      });
    }

    function promoteMermaidBlocks(root) {
      root.querySelectorAll("pre code.language-mermaid").forEach((code) => {
        const pre = code.parentElement;
        if (!pre) return;
        const div = document.createElement("div");
        div.className = "mermaid";
        div.textContent = code.textContent;
        pre.replaceWith(div);
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      const raw = document.getElementById("md-source").textContent;
      if (window.marked && raw) {
        const { md: mdProtected, store: mathStore } = protectMath(raw);

        // Customize marked table renderer for mobile overflow isolation
        const renderer = new marked.Renderer();
        const origTable = renderer.table.bind(renderer);
        renderer.table = function(header, body) {
          const html = origTable(header, body);
          return '<div class="table-wrap">' + html + '</div>';
        };

        marked.setOptions({
          gfm: true,
          breaks: true,
          renderer: renderer
        });

        let html = marked.parse(mdProtected);
        html = restoreMath(html, mathStore);

        const contentEl = document.getElementById("content");
        contentEl.innerHTML = html;

        bindMathCopyButtons(contentEl);
        promoteMermaidBlocks(contentEl);

        // Build dynamic Sticky TOC for sidebar
        (function initStickyTOC() {
          const allHeadings = Array.from(contentEl.querySelectorAll("h1, h2, h3"));
          const headings = allHeadings.filter((h, idx) => {
            if (h.tagName.toLowerCase() === "h1" && idx === 0 && h.previousElementSibling === null) {
              return false;
            }
            return true;
          });
          const tocNav = document.getElementById("toc-nav");
          const tocSidebar = document.getElementById("toc-sidebar");

          if (headings.length >= 2 && tocNav && tocSidebar) {
            const ul = document.createElement("ul");
            ul.className = "toc-list";

            headings.forEach((h, idx) => {
              if (!h.id) {
                h.id = "sec-" + idx;
              }
              const li = document.createElement("li");
              li.className = "toc-item " + h.tagName.toLowerCase();

              const a = document.createElement("a");
              a.className = "toc-link";
              a.href = "#" + h.id;
              a.textContent = h.textContent.replace(/^[\\s#]+/, "").trim();

              li.appendChild(a);
              ul.appendChild(li);
            });

            tocNav.innerHTML = "";
            tocNav.appendChild(ul);

            // ScrollSpy via IntersectionObserver
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  const id = entry.target.id;
                  document.querySelectorAll(".toc-link").forEach(link => {
                    if (link.getAttribute("href") === "#" + id) {
                      link.parentElement.classList.add("active");
                      link.classList.add("active");
                    } else {
                      link.parentElement.classList.remove("active");
                      link.classList.remove("active");
                    }
                  });
                }
              });
            }, { rootMargin: "0px 0px -75% 0px", threshold: 0 });

            headings.forEach(h => observer.observe(h));
          } else if (tocSidebar) {
            tocSidebar.style.display = "none";
          }
        })();

        // Automatically rewrite relative .md links to .html
        contentEl.querySelectorAll("a").forEach((a) => {
          const href = a.getAttribute("href");
          if (href && !href.startsWith("http://") && !href.startsWith("https://") && !href.startsWith("#")) {
            if (href.endsWith(".md")) {
              a.setAttribute("href", href.replace(/\\.md$/, ".html"));
            } else if (href.includes(".md#")) {
              a.setAttribute("href", href.replace(/\\.md#/, ".html#"));
            }
          }
        });

        // Click image to open in new tab for full resolution
        contentEl.querySelectorAll("img").forEach((img) => {
          img.title = "クリックしてフル解像度で表示";
          img.addEventListener("click", () => {
            window.open(img.src, "_blank");
          });
        });

        // Render Mermaid & MathJax
        const typesetMath = () => {
          if (window.MathJax && window.MathJax.typesetPromise) {
            return window.MathJax.typesetPromise([contentEl]).catch((err) => console.error("MathJax error:", err));
          }
          return Promise.resolve();
        };

        const runMermaid = () => {
          if (!window.mermaid) return Promise.resolve();
          window.mermaid.initialize({
            startOnLoad: false,
            theme: "dark",
            securityLevel: "loose",
            flowchart: { useMaxWidth: true, htmlLabels: true },
            sequence: { useMaxWidth: true }
          });
          return window.mermaid.run({ nodes: contentEl.querySelectorAll(".mermaid") });
        };

        runMermaid()
          .catch(() => {})
          .then(() => {
            if (window.MathJax && window.MathJax.startup && window.MathJax.startup.promise) {
              return window.MathJax.startup.promise.then(typesetMath);
            }
            return typesetMath();
          });
      }
    });
  </script>
</body>
</html>
"""


def extract_title_and_eyebrow(md_text: str, default_title: str) -> tuple[str, str, bool]:
    title = default_title
    eyebrow = "Document · Knowledge Base"

    h1_matches = re.findall(r"^#\s+(.+)$", md_text, flags=re.MULTILINE)
    has_single_h1 = False
    if len(h1_matches) == 1:
        title = h1_matches[0].strip()
        has_single_h1 = True

    lower = md_text.lower()
    if "quantum" in lower or "量子" in lower:
        eyebrow = "Quantum Information & Research Note"
    elif "seminar" in lower or "就活" in lower or "面接" in lower or "インターン" in lower:
        eyebrow = "Career & Application · Tactical Sheet"
    elif "雑談" in lower or "幸福" in lower or "生活" in lower or "パートナー" in lower:
        eyebrow = "Life Events & Communication · Protocol"
    elif "finance" in lower or "資産" in lower or re.search(r"\bsim\b", lower):
        eyebrow = "Finance & Life Planning"

    return title, eyebrow, has_single_h1


def auto_detect_theme(md_text: str) -> str:
    lower = md_text.lower()
    if "雑談" in lower or "幸福" in lower or "アジェンダ" in lower or "生活" in lower:
        return "sepia"
    return "tactical"


def open_in_browser(target_path: Path):
    """Open target in browser, ALWAYS prioritizing MBA via ssh, falling back to local."""
    target_str = str(target_path)
    url = None
    try:
        ts_ip = subprocess.check_output(["tailscale", "ip", "-4"], text=True, timeout=2).strip().splitlines()[0]
        p_str = str(target_path.resolve())
        if "/life-brain/" in p_str:
            rel = p_str.split("/life-brain/", 1)[1]
            url = f"http://{ts_ip}:8770/{rel}"
        elif "/research-brain/" in p_str:
            rel = p_str.split("/research-brain/", 1)[1]
            url = f"http://{ts_ip}:8766/{rel}"
        elif "/hybrid-workflow-sandbox/" in p_str:
            rel = p_str.split("/hybrid-workflow-sandbox/", 1)[1]
            url = f"http://{ts_ip}:8765/{rel}"
    except Exception:
        pass

    dest = url or target_str

    res = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", "mba", f"open '{dest}'"],
        capture_output=True,
    )
    if res.returncode == 0:
        print(f"Opened on MBA: {dest}")
        return

    print("ssh mba failed or unreachable. Falling back to local open...")
    if sys.platform == "darwin":
        subprocess.run(["open", target_str])
    elif os.name == "posix":
        subprocess.run(["xdg-open", target_str])


_TABLE_SEP_RE = re.compile(r"^\|[\s:|-]+\|$")


def _escape_pipes_in_inline_math(text: str) -> str:
    """Escape unescaped | inside $...$ or \\(...\\) so GFM table parsing does not split ket notation."""
    def repl_dollar(m: re.Match) -> str:
        body = m.group(1)
        body = re.sub(r"(?<!\\)\|", r"\\|", body)
        return f"${body}$"

    def repl_paren(m: re.Match) -> str:
        body = m.group(1)
        body = re.sub(r"(?<!\\)\|", r"\\|", body)
        return f"\\({body}\\)"

    text = re.sub(r"\$([^$\n]+?)\$", repl_dollar, text)
    text = re.sub(r"\\\((.+?)\\\)", repl_paren, text)
    return text


def escape_pipes_in_table_inline_math(md_text: str) -> str:
    out_lines: list[str] = []
    for line in md_text.splitlines():
        stripped = line.strip()
        if not (stripped.startswith("|") and "|" in stripped[1:]):
            out_lines.append(line)
            continue
        compact = stripped.replace(" ", "")
        if _TABLE_SEP_RE.match(compact):
            out_lines.append(line)
            continue
        cells = re.split(r"(?<!\\)\|", line)
        escaped_cells = [_escape_pipes_in_inline_math(cell) for cell in cells]
        out_lines.append("|".join(escaped_cells))
    return "\n".join(out_lines)


def compile_markdown_to_html(
    src_path: Path,
    dst_path: Path | None = None,
    theme_name: str = "auto",
    custom_title: str | None = None,
    open_browser: bool = False,
) -> Path:
    if not src_path.exists():
        raise FileNotFoundError(f"Source file not found: {src_path}")

    if dst_path is None:
        dst_path = src_path.with_suffix(".html")

    md_text = src_path.read_text(encoding="utf-8")
    title, eyebrow, has_single_h1 = extract_title_and_eyebrow(md_text, default_title=src_path.stem)
    if custom_title:
        title = custom_title

    if theme_name == "auto" or theme_name not in THEMES:
        theme_name = auto_detect_theme(md_text)

    theme_cfg = THEMES[theme_name]
    css_vars = "\n".join(f"      --{k.replace('_', '-')}: {v};" for k, v in theme_cfg.items())

    escaped_md = escape_pipes_in_table_inline_math(md_text)
    safe_md = escaped_md.replace("</script>", "<\\/script>")
    content_class = "hide-first-h1" if has_single_h1 else ""

    html_content = (
        HTML_TEMPLATE.replace("__CSS_VARS__", css_vars)
        .replace("__TITLE__", title)
        .replace("__EYEBROW__", eyebrow)
        .replace("__CONTENT_CLASS__", content_class)
        .replace("__SRC_FILENAME__", src_path.name)
        .replace("__DST_FILENAME__", dst_path.name)
        .replace("__SRC_RELPATH__", src_path.name)
        .replace("__MARKDOWN_RAW__", safe_md)
    )

    dst_path.write_text(html_content, encoding="utf-8")
    print(f"Generated ({theme_name}): {dst_path}")

    if open_browser:
        open_in_browser(dst_path)

    return dst_path


def main():
    parser = argparse.ArgumentParser(
        description="Compile any Markdown into a modern responsive, print-ready HTML."
    )
    parser.add_argument("input", help="Path to input Markdown file (.md)")
    parser.add_argument("-o", "--output", help="Path to output HTML file (.html)")
    parser.add_argument(
        "-t",
        "--theme",
        choices=["auto", "tactical", "sepia", "minimal"],
        default="auto",
        help="Visual theme (default: auto detect based on content)",
    )
    parser.add_argument("--title", help="Custom page title")
    parser.add_argument("--open", action="store_true", help="Open generated HTML in browser")

    args = parser.parse_args()
    src = Path(args.input).resolve()
    dst = Path(args.output).resolve() if args.output else None

    compile_markdown_to_html(
        src_path=src,
        dst_path=dst,
        theme_name=args.theme,
        custom_title=args.title,
        open_browser=args.open,
    )


if __name__ == "__main__":
    main()
