#!/usr/bin/env python3
"""md-to-html: Universal Markdown to Modern Responsive Standalone HTML Builder.

Keep Markdown as the single source of truth (SSOT).
Compiles any Markdown document into an elegant, standalone, mobile-friendly,
and print-ready HTML page with marked.js, MathJax (with LaTeX copy buttons),
and Mermaid diagram support.

Part of dotfiles / agent skills.
Usage:
  md-to-html input.md [-o output.html] [--theme tactical|sepia|minimal] [--open]
"""
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

