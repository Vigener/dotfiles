#!/usr/bin/env bash
# T3 Code を再起動して、常駐 opencode サーバに AGENTS.md を読み直させる。
#
# なぜ必要か: T3 は `opencode serve` を1プロセスだけ立て、全スレッドがそこに乗る。
# そのサーバは起動時に agents/GLOBAL_RULES.md を読んで以後保持するので、
# ルールを変えても T3 を再起動するまで古い指示が配られ続ける（agents/docs/lessons.md §5）。
#
# 使い方: T3 の外（MBA からの ssh、または mini の別ターミナル）で実行する。
# このスクリプトは T3 を落とすので、T3 のスレッド内から実行すると自分が切れる。
set -euo pipefail

APP="T3 Code (Beta)"

echo "==> quit: $APP"
osascript -e "quit app \"$APP\"" >/dev/null 2>&1 || true
for _ in $(seq 1 20); do
  pgrep -f '/MacOS/T3 Code' >/dev/null 2>&1 || break
  sleep 0.5
done

# 取り残しのサーバ（T3 の子と CLI 用の --service）を落とす。次回起動で再生成される。
pkill -f 'opencode serve' >/dev/null 2>&1 || true
sleep 1

echo "==> start: $APP"
open -a "$APP"
sleep 5

echo "==> state"
pgrep -f '/MacOS/T3 Code' >/dev/null 2>&1 && echo "T3: running" || echo "T3: NOT running (MBA からなら launchctl asuser を使って再実行)"
ps -Ao pid,lstart,command | grep '[o]pencode serve' | cut -c1-100 \
  || echo "opencode serve: まだ無し（最初のスレッド実行時に立つ）"
