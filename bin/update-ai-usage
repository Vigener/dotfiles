#!/usr/bin/env python3
"""
update-ai-usage
Fetch usage and quota limits for Antigravity, Cursor, DeepSeek, and Claude (Team),
calculate weekly burn rates (pacing & depletion ETA), trigger desktop alerts,
write RunCat Neo custom metrics JSON, and format output for Raycast / CLI.
"""

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timezone

# Threshold to trigger alert display (show reset countdown when quota <= this %)
ALERT_THRESHOLD = 15
# Threshold to show weekly quota warning in menu bar (<= 50%)
WEEKLY_WARN_THRESHOLD = 50
# Pacing thresholds
BURN_RATE_WARN = 1.5      # >= 1.5x triggers warning (fire icon)
BURN_RATE_CRITICAL = 2.0  # >= 2.0x triggers desktop notification if ETA <= 24h
ALERT_COOLDOWN_SEC = 10800  # 3 hours cooldown between notifications per service


def find_agy_binary():
    candidates = [
        shutil.which("agy"),
        "/opt/homebrew/bin/agy",
        "/usr/local/bin/agy",
        os.path.expanduser("~/.local/bin/agy"),
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def fetch_antigravity_usage(agy_bin):
    if not agy_bin:
        return {"error": "agy command not found"}
    try:
        cmd = [agy_bin, "-p", "/usage", "--output-format", "json"]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        if res.returncode != 0:
            return {"error": f"agy exited with code {res.returncode}: {res.stderr.strip()}"}
        data = json.loads(res.stdout)
        return data.get("command", {}).get("data", {})
    except Exception as e:
        return {"error": str(e)}


def fetch_cursor_usage():
    db_path = os.path.expanduser("~/Library/Application Support/Cursor/User/globalStorage/state.vscdb")
    if not os.path.exists(db_path):
        return {"error": "state.vscdb not found"}

    token = None
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        c = conn.cursor()
        c.execute("SELECT value FROM ItemTable WHERE key = 'cursorAuth/accessToken';")
        row = c.fetchone()
        conn.close()
        if row and row[0]:
            token = row[0]
    except Exception as e:
        return {"error": f"Failed to read token from state.vscdb: {e}"}

    if not token:
        return {"error": "cursorAuth/accessToken not found in state.vscdb"}

    try:
        req = urllib.request.Request(
            "https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage",
            data=b"{}",
            headers={
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json",
                "Connect-Protocol-Version": "1",
            },
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        return {"error": f"Failed to call Cursor API: {e}"}


def fetch_deepseek_balance():
    token = os.environ.get("DEEPSEEK_API_KEY")
    if not token:
        auth_path = os.path.expanduser("~/.local/share/opencode/auth.json")
        if os.path.exists(auth_path):
            try:
                with open(auth_path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                ds = data.get("deepseek", {})
                if isinstance(ds, str):
                    token = ds
                elif isinstance(ds, dict):
                    token = ds.get("key") or ds.get("apiKey") or ds.get("token")
            except Exception:
                pass

    if not token:
        return {"error": "DeepSeek API key not found"}

    try:
        req = urllib.request.Request(
            "https://api.deepseek.com/user/balance",
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/json",
            },
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        return {"error": f"Failed to call DeepSeek API: {e}"}


CLAUDE_KEYCHAIN_SERVICE = "Claude Code-credentials"
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
# The usage endpoint rate-limits (429) when polled aggressively, so reuse a recent
# result and keep serving the last good one while the endpoint is cooling down.
CLAUDE_CACHE_TTL_SEC = 900
CLAUDE_CACHE_MAX_STALE_SEC = 6 * 3600
CLAUDE_CACHE_PATH = "~/.cache/update-ai-usage/claude-usage.json"


def read_claude_oauth_token():
    """
    Read the Claude Code OAuth access token (macOS Keychain first).
    Claude Code stores and refreshes `Claude Code-credentials`, so reading it
    every run keeps us on a valid token without our own refresh logic.
    """
    try:
        res = subprocess.run(
            ["security", "find-generic-password", "-s", CLAUDE_KEYCHAIN_SERVICE, "-w"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            oauth = (data.get("claudeAiOauth") or {}) if isinstance(data, dict) else {}
            token = oauth.get("accessToken")
            if token:
                return token, oauth.get("subscriptionType")
    except Exception:
        pass

    # Older layouts kept the same JSON in a plain file
    cred_path = os.path.expanduser("~/.config/anthropic/credentials/default.json")
    if os.path.exists(cred_path):
        try:
            with open(cred_path, "r", encoding="utf-8") as f:
                cred = json.load(f)
            oauth = (cred.get("claudeAiOauth") or {}) if isinstance(cred, dict) else {}
            token = cred.get("access_token") or oauth.get("accessToken")
            if token:
                return token, oauth.get("subscriptionType")
        except Exception:
            pass

    return None, None


def read_claude_cache():
    try:
        with open(os.path.expanduser(CLAUDE_CACHE_PATH), "r", encoding="utf-8") as f:
            cached = json.load(f)
        if isinstance(cached, dict) and isinstance(cached.get("data"), dict):
            return cached
    except Exception:
        pass
    return None


def write_claude_cache(data):
    path = os.path.expanduser(CLAUDE_CACHE_PATH)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        temp_fd, temp_path = tempfile.mkstemp(
            dir=os.path.dirname(path), prefix="claude_", suffix=".tmp"
        )
        with os.fdopen(temp_fd, "w", encoding="utf-8") as f:
            json.dump(
                {"fetched_at": datetime.now(timezone.utc).timestamp(), "data": data}, f
            )
        os.replace(temp_path, path)
    except Exception:
        pass


def claude_cache_suffix(claude):
    """Describe how old the served value is when it came from the cache."""
    if not claude or not claude.get("cached"):
        return ""
    age = claude.get("cache_age_sec") or 0
    if age < 60:
        return ""
    fetched_at = datetime.now(timezone.utc).timestamp() - age
    stamp = datetime.fromtimestamp(fetched_at).strftime("%H:%M")
    return f" · {stamp}時点"


def fetch_claude_usage():
    """
    Fetch Claude subscription rate-limit usage via Claude Code's OAuth endpoint.

    Same source as `/usage` in the CLI. The endpoint reports `utilization` as a
    fraction of the window already used (0-1, may exceed 1), so it is scaled to
    percent here for the 5-hour session window and the 7-day weekly window.
    NOTE: API keys cannot call this endpoint; a Claude Code OAuth login is required.
    """
    cached = read_claude_cache()
    cache_age = None
    if cached:
        cache_age = max(
            0.0,
            datetime.now(timezone.utc).timestamp() - float(cached.get("fetched_at", 0)),
        )
        if cache_age < CLAUDE_CACHE_TTL_SEC:
            return {**cached["data"], "cached": True, "cache_age_sec": round(cache_age)}

    def stale_fallback(error):
        if cached and cache_age is not None and cache_age < CLAUDE_CACHE_MAX_STALE_SEC:
            return {
                **cached["data"],
                "cached": True,
                "stale": True,
                "cache_age_sec": round(cache_age),
                "error": error,
            }
        return {"error": error}

    token, plan = read_claude_oauth_token()
    if not token:
        return stale_fallback("Claude Code OAuth credentials not found")

    try:
        req = urllib.request.Request(
            CLAUDE_USAGE_URL,
            headers={
                "Authorization": f"Bearer {token}",
                "anthropic-beta": "oauth-2025-04-20",
                "anthropic-version": "2023-06-01",
                "Accept": "application/json",
            },
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        return stale_fallback(f"HTTP {e.code}")
    except Exception as e:
        return stale_fallback(str(e))

    def to_percent(value):
        try:
            return max(0.0, min(100.0, round(float(value) * 1000) / 10))
        except (TypeError, ValueError):
            return None

    result = {"plan": plan}
    for key in ("five_hour", "seven_day"):
        bucket = data.get(key) or {}
        result[key] = {
            "used_pct": to_percent(bucket.get("utilization")),
            "resets_at": bucket.get("resets_at"),
        }
    result["limits"] = data.get("limits") or []
    # limits[] is authoritative. The utilization field behind five_hour/seven_day can be
    # stale or saturated (2026-10-21: five_hour.utilization=1.0 while session percent=4).
    for kind, key in (("session", "five_hour"), ("weekly_all", "seven_day")):
        if key not in result:
            continue
        for lim in result["limits"]:
            pct = lim.get("percent")
            if lim.get("kind") == kind and pct is not None:
                result[key]["used_pct"] = to_percent(float(pct) / 100)
                break
    result["extra_usage_enabled"] = bool(
        (data.get("extra_usage") or {}).get("is_enabled")
    )

    write_claude_cache(result)
    return result


def format_time_remaining(reset_time_str):
    """Calculate remaining human-readable time from an ISO timestamp."""
    if not reset_time_str:
        return ""
    try:
        dt = datetime.fromisoformat(reset_time_str.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        diff = dt - now
        total_sec = int(diff.total_seconds())
        if total_sec <= 0:
            return "now"
        days = total_sec // 86400
        hours = (total_sec % 86400) // 3600
        mins = (total_sec % 3600) // 60
        if days > 0:
            return f"{days}d{hours}h"
        elif hours > 0:
            return f"{hours}h{mins}m"
        else:
            return f"{mins}m"
    except Exception:
        return ""


def format_cursor_reset(cycle_end):
    """Calculate remaining human-readable time for Cursor billing cycle reset."""
    if not cycle_end:
        return ""
    try:
        dt = datetime.fromtimestamp(int(cycle_end) / 1000, tz=timezone.utc)
        now = datetime.now(timezone.utc)
        diff = dt - now
        total_sec = int(diff.total_seconds())
        if total_sec <= 0:
            return "now"
        days = total_sec // 86400
        hours = (total_sec % 86400) // 3600
        if days > 0:
            return f"{days}d"
        elif hours > 0:
            return f"{hours}h"
        else:
            mins = (total_sec % 3600) // 60
            return f"{mins}m"
    except Exception:
        return ""


def calculate_weekly_pacing(rem_fraction, reset_time_str):
    """
    Calculate burn rate multiplier, depletion ETA, and safe daily budget
    based on a 7-day rolling quota window.
    """
    if not reset_time_str or rem_fraction is None:
        return None
    try:
        dt = datetime.fromisoformat(reset_time_str.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        remaining_sec = max(0, int((dt - now).total_seconds()))
        cycle_total_sec = 7 * 86400  # 604800 seconds in 1 week
        elapsed_sec = max(1, cycle_total_sec - remaining_sec)

        rem_frac = max(0.0, min(1.0, float(rem_fraction)))
        used_frac = max(0.0, 1.0 - rem_frac)

        # Smooth early-cycle burst noise (clamp minimum elapsed evaluation window to 12h)
        effective_elapsed_sec = max(12 * 3600, elapsed_sec)
        effective_elapsed_frac = effective_elapsed_sec / cycle_total_sec

        burn_rate = used_frac / effective_elapsed_frac if effective_elapsed_frac > 0 else 1.0

        burn_per_sec = used_frac / elapsed_sec if elapsed_sec > 0 else 0
        if burn_per_sec > 0 and rem_frac > 0:
            time_to_empty_sec = rem_frac / burn_per_sec
            time_to_empty_hr = time_to_empty_sec / 3600.0
        elif rem_frac <= 0:
            time_to_empty_hr = 0.0
        else:
            time_to_empty_hr = 9999.0

        days_rem = max(0.1, remaining_sec / 86400.0)
        safe_daily_pct = (rem_frac * 100.0) / days_rem

        # Overburning: high burn rate AND quota already depleted below safe margin (<= 70%)
        is_overburning = (burn_rate >= BURN_RATE_WARN and rem_frac <= 0.70)
        is_critical = (burn_rate >= BURN_RATE_CRITICAL and time_to_empty_hr <= 24.0 and rem_frac <= 0.50)

        return {
            "burn_rate": burn_rate,
            "remaining_pct": int(round(rem_frac * 100)),
            "time_to_empty_hr": time_to_empty_hr,
            "safe_daily_pct": safe_daily_pct,
            "remaining_hours": remaining_sec / 3600.0,
            "is_overburning": is_overburning,
            "is_critical": is_critical,
        }
    except Exception:
        return None


def send_quota_notification(service_name, burn_rate, time_to_empty_hr, rem_pct):
    """Send macOS notification if alert cooldown has elapsed."""
    cache_dir = os.path.expanduser("~/.cache/update-ai-usage")
    os.makedirs(cache_dir, exist_ok=True)
    stamp_file = os.path.join(cache_dir, f"last_alert_{service_name.lower().replace(' ', '_')}.timestamp")

    now_ts = datetime.now().timestamp()
    if os.path.exists(stamp_file):
        try:
            with open(stamp_file, "r") as f:
                last_ts = float(f.read().strip())
            if now_ts - last_ts < ALERT_COOLDOWN_SEC:
                return  # Cooldown active
        except Exception:
            pass

    title = f"⚠️ AI Quota Alert: {service_name}"
    subtitle = f"消費ペースが危険水域です ({burn_rate:.1f}x)"
    if time_to_empty_hr < 1.0:
        eta_str = f"{int(time_to_empty_hr * 60)}分後"
    else:
        eta_str = f"約{int(round(time_to_empty_hr))}時間後"
    body = f"週枠残り{rem_pct}%。このペースだと{eta_str}に枯渇。他モデルへの分散を推奨。"

    cmd = [
        "osascript",
        "-e",
        f'display notification "{body}" with title "{title}" subtitle "{subtitle}"',
    ]
    try:
        subprocess.run(cmd, capture_output=True, timeout=5)
        with open(stamp_file, "w") as f:
            f.write(str(now_ts))
    except Exception:
        pass


def format_progress_bar(percentage, length=10):
    clamped = max(0.0, min(100.0, float(percentage)))
    filled = int(round(clamped / 100 * length))
    return "█" * filled + "░" * (length - filled)


def classify_agy_group(group_name):
    """Classify Antigravity quota group: 'argon', 'gemini', or 'claude'."""
    if "Argon" in group_name:
        return "argon"
    elif "Gemini" in group_name:
        return "gemini"
    else:
        return "claude"


def build_metrics_bar(agy, cursor, deepseek, claude=None):
    """
    Compact one-line status shared by the RunCat menu bar and Raycast inline.

    Grammar: `Agy[G:0% Ar:34% C:0%] Cu:2%/0% Cl:100% DS:$1.22`
      - percentages keep their `%`; a bare `0` is too easy to misread
      - lowercase `w` marks the weekly window (`G:0%(w0%)`) so it never reads
        like another service tag (G/Ar/C/Cl/Cu/DS)
      - weekly detail appears only when it matters (<= 50% or overburning)
        and differs from the primary number (`G:0%(w0%)` collapses to `G:0%`)
      - Claude compares its weekly against 5h, so `Cl:100%(w0%)` keeps the 0
      - 🔥 burn-rate is dropped once weekly hits 0% (no pace left to manage)
      - reset countdowns appear only when a window is nearly empty
    """
    parts = []

    agy_items = {}
    if "groups" in agy:
        for g in agy["groups"]:
            g_type = classify_agy_group(g.get("name", ""))
            b_dict = {b.get("window"): b for b in g.get("buckets", [])}
            five_h = b_dict.get("5h")
            weekly = b_dict.get("weekly")
            w_rem = None
            w_pacing = None
            if weekly:
                w_rem = int(round(float(weekly.get("remaining_fraction", 0.0)) * 100))
                w_pacing = calculate_weekly_pacing(
                    weekly.get("remaining_fraction"), weekly.get("reset_time")
                )

            bucket = five_h or weekly
            if not bucket:
                continue
            if five_h is None:
                # the primary number already *is* the weekly window
                w_rem = None
            rem_pct = int(round(float(bucket.get("remaining_fraction", 0.0)) * 100))
            if five_h and w_rem == 0:
                rem_pct = 0

            tag = {"gemini": "G", "argon": "Ar", "claude": "C"}[g_type]
            item = f"{tag}:{rem_pct}%"

            if w_rem is not None:
                # 枯渇後（W0%）は燃焼ペースを出しても意味がないので炎を付けない
                if w_pacing and w_pacing["is_overburning"] and w_rem > 0:
                    rate = f"🔥{w_pacing['burn_rate']:.1f}x" if g_type == "gemini" else "🔥"
                    item += f"(w{w_rem}%{rate})"
                elif w_rem <= WEEKLY_WARN_THRESHOLD and w_rem != rem_pct:
                    # 週次が主数値と同じなら同じ数字の繰り返しなので畳む (G:0%(w0%) → G:0%)
                    item += f"(w{w_rem}%)"

            if rem_pct <= ALERT_THRESHOLD and w_rem != 0:
                rem_time = format_time_remaining(bucket.get("reset_time", ""))
                if rem_time:
                    item += f":{rem_time}"
            agy_items[tag] = item

    agy_parts = [agy_items[tag] for tag in ("G", "Ar", "C") if tag in agy_items]
    if agy_parts:
        parts.append("Agy[" + " ".join(agy_parts) + "]")
    elif "error" in agy:
        parts.append("Agy:Err")

    if "planUsage" in cursor:
        plan = cursor["planUsage"]
        auto_left = int(round(max(0.0, 100.0 - float(plan.get("autoPercentUsed", 0.0)))))
        api_left = int(round(max(0.0, 100.0 - float(plan.get("apiPercentUsed", 0.0)))))
        item = f"Cu:{auto_left}%/{api_left}%"
        if auto_left <= ALERT_THRESHOLD or api_left <= ALERT_THRESHOLD:
            reset = format_cursor_reset(cursor.get("billingCycleEnd"))
            if reset:
                item += f"({reset})"
        parts.append(item)
    elif "error" in cursor:
        parts.append("Cu:Err")

    if claude and "five_hour" in claude:
        fh = claude.get("five_hour") or {}
        wk = claude.get("seven_day") or {}
        used = fh.get("used_pct")
        if used is not None:
            left = max(0.0, min(100.0, 100.0 - float(used)))
            item = f"Cl:{left:.0f}%"
            used_w = wk.get("used_pct")
            if used_w is not None:
                left_w = max(0.0, min(100.0, 100.0 - float(used_w)))
                # Agy と同じく、週次は危険域（<= 50%）のときだけ出す。
                # 5h と同じ値なら繰り返しになるのでさらに畳む。
                if left_w <= WEEKLY_WARN_THRESHOLD and int(round(left_w)) != int(round(left)):
                    item += f"(w{left_w:.0f}%)"
            if left <= ALERT_THRESHOLD:
                rem_time = format_time_remaining(fh.get("resets_at", ""))
                if rem_time:
                    item += f":{rem_time}"
            parts.append(item)

    if "balance_infos" in deepseek and deepseek["balance_infos"]:
        b_info = deepseek["balance_infos"][0]
        symbol = "$" if b_info.get("currency", "USD") == "USD" else "¥"
        parts.append(f"DS:{symbol}{float(b_info.get('total_balance', 0)):.2f}")

    return " ".join(parts) if parts else "---"


def build_runcat_payload(agy, cursor, deepseek, claude=None):
    metrics = []
    agy_g_pacing = None

    if "groups" in agy:
        for g in agy["groups"]:
            g_name = g.get("name", "")
            g_type = classify_agy_group(g_name)
            if g_type == "argon":
                label_prefix = "Agy Argon"
            elif g_type == "gemini":
                label_prefix = "Agy Gemini"
            else:
                label_prefix = "Agy Claude"

            b_dict = {b.get("window"): b for b in g.get("buckets", [])}
            w_bucket = b_dict.get("weekly", {})
            w_rem_pct = int(round(float(w_bucket.get("remaining_fraction", 1.0)) * 100)) if w_bucket else 100
            weekly_is_zero = (w_rem_pct <= 0)

            # Weekly pacing calculation
            w_pacing = None
            if w_bucket:
                w_pacing = calculate_weekly_pacing(w_bucket.get("remaining_fraction"), w_bucket.get("reset_time"))

            for b in g.get("buckets", []):
                win = b.get("window", "")
                rem_frac = float(b.get("remaining_fraction", 0.0))
                # weekly が 0 の場合、5h の実質残量も 0% として扱う
                if win == "5h" and weekly_is_zero:
                    rem_frac = 0.0
                rem_time = format_time_remaining(b.get("reset_time", ""))
                time_str = f" ({rem_time}後)" if rem_time else ""
                metrics.append({
                    "title": f"{label_prefix} ({win})",
                    "formattedValue": f"{rem_frac * 100:.0f}%{time_str}",
                    "normalizedValue": round(rem_frac, 3),
                })
                if g_type == "gemini" and win == "weekly":
                    agy_g_pacing = w_pacing

    # Add Pacing items to RunCat detailed dropdown
    # 枯渇済み（残量 0% 表示）はペース配分の意味が無いので出さない
    if agy_g_pacing and agy_g_pacing["is_overburning"] and agy_g_pacing["remaining_pct"] > 0:
        eta_h = agy_g_pacing["time_to_empty_hr"]
        eta_desc = f"約{eta_h:.0f}h後" if eta_h < 72 else f"約{eta_h/24:.1f}日後"
        metrics.append({
            "title": "Gemini Pacing (Burn Rate)",
            "formattedValue": f"🔥 {agy_g_pacing['burn_rate']:.1f}x (枯渇予測: {eta_desc})",
            "normalizedValue": min(1.0, agy_g_pacing["burn_rate"] / 4.0),
        })
        metrics.append({
            "title": "Gemini Safe Daily Target",
            "formattedValue": f"~{agy_g_pacing['safe_daily_pct']:.1f}%/day",
            "normalizedValue": min(1.0, agy_g_pacing["safe_daily_pct"] / 20.0),
        })

    if "planUsage" in cursor:
        plan = cursor["planUsage"]
        auto_used = float(plan.get("autoPercentUsed", 0.0))
        api_used = float(plan.get("apiPercentUsed", 0.0))

        # Align with T3 Code UI (% left / remaining)
        auto_left = max(0.0, 100.0 - auto_used)
        api_left = max(0.0, 100.0 - api_used)

        metrics.append({
            "title": "Cursor Models (Left)",
            "formattedValue": f"{auto_left:.0f}%",
            "normalizedValue": max(0.0, min(1.0, round(auto_left / 100.0, 3))),
        })
        metrics.append({
            "title": "Other Models (Left)",
            "formattedValue": f"{api_left:.0f}%",
            "normalizedValue": max(0.0, min(1.0, round(api_left / 100.0, 3))),
        })

        cycle_end = cursor.get("billingCycleEnd")
        if cycle_end:
            try:
                dt = datetime.fromtimestamp(int(cycle_end) / 1000, tz=timezone.utc)
                now = datetime.now(timezone.utc)
                diff = dt - now
                days = diff.days
                rem_str = f" ({days}d後)" if days > 0 else ""
                local_dt = datetime.fromtimestamp(int(cycle_end) / 1000)
                metrics.append({
                    "title": "Cursor Cycle Reset",
                    "formattedValue": f"{local_dt.strftime('%m/%d %H:%M')}{rem_str}",
                })
            except Exception:
                pass

    if "balance_infos" in deepseek and deepseek["balance_infos"]:
        b_info = deepseek["balance_infos"][0]
        curr = b_info.get("currency", "USD")
        tot = b_info.get("total_balance", "0.00")
        symbol = "$" if curr == "USD" else "¥"
        metrics.append({
            "title": f"DeepSeek Balance ({curr})",
            "formattedValue": f"{symbol}{tot}",
            "normalizedValue": min(1.0, max(0.0, round(float(tot) / 10.0, 3))),
        })

    # Claude (Claude Code subscription: 5-hour session + weekly windows)
    if claude and "five_hour" in claude:
        fh = claude.get("five_hour") or {}
        wk = claude.get("seven_day") or {}
        used_5h = fh.get("used_pct")
        used_7d = wk.get("used_pct")
        if used_5h is not None:
            left_5h = max(0.0, min(100.0, 100.0 - float(used_5h)))
            left_7d = None if used_7d is None else max(0.0, min(100.0, 100.0 - float(used_7d)))
            label = "Claude Team" if claude.get("plan") == "team" else "Claude"
            suffix = claude_cache_suffix(claude)

            rem_time = format_time_remaining(fh.get("resets_at", ""))
            metrics.append({
                "title": f"{label} (5h, left){suffix}",
                "formattedValue": f"{left_5h:.0f}%" + (f" ({rem_time}後)" if rem_time else ""),
                "normalizedValue": round(left_5h / 100.0, 3),
            })
            if left_7d is not None:
                w_time = format_time_remaining(wk.get("resets_at", ""))
                metrics.append({
                    "title": f"{label} (weekly, left){suffix}",
                    "formattedValue": f"{left_7d:.0f}%" + (f" ({w_time}後)" if w_time else ""),
                    "normalizedValue": round(left_7d / 100.0, 3),
                })
    elif claude and "error" in claude:
        # keep the menu bar clean; surface the failure in the dropdown instead
        metrics.append({
            "title": "Claude (unavailable)",
            "formattedValue": claude["error"],
        })

    metrics_bar = build_metrics_bar(agy, cursor, deepseek, claude)

    return {
        "title": "AI Quotas",
        "symbol": "brain.head.profile",
        "metricsBarValue": metrics_bar,
        "metrics": metrics,
        "lastUpdatedDate": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    }


def format_inline(agy, cursor, deepseek, claude=None):
    """Raycast inline mode: same compact line as the RunCat menu bar."""
    return build_metrics_bar(agy, cursor, deepseek, claude)


def format_markdown(agy, cursor, deepseek, claude=None):
    lines = ["# 🧠 AI Quotas & Usage Summary\n"]

    # Antigravity section
    lines.append("## Antigravity (agy)")
    if "groups" in agy:
        for g in agy["groups"]:
            g_name = g.get("name", "")
            g_desc = g.get("description", "")
            lines.append(f"### {g_name}")
            if g_desc:
                lines.append(f"> _{g_desc}_\n")

            b_dict = {b.get("window"): b for b in g.get("buckets", [])}
            w_bucket = b_dict.get("weekly", {})
            w_rem_pct = int(round(float(w_bucket.get("remaining_fraction", 1.0)) * 100)) if w_bucket else 100
            weekly_is_zero = (w_rem_pct <= 0)

            # Calculate pacing for weekly bucket
            w_pacing = None
            if w_bucket:
                w_pacing = calculate_weekly_pacing(w_bucket.get("remaining_fraction"), w_bucket.get("reset_time"))

            for b in g.get("buckets", []):
                win = b.get("window", "")
                rem_frac = float(b.get("remaining_fraction", 0.0))
                pct = rem_frac * 100
                desc = b.get("description", "")
                rem_time = format_time_remaining(b.get("reset_time", ""))
                time_badge = f" `[リセットまで {rem_time}]`" if rem_time else ""

                if win == "5h" and weekly_is_zero:
                    bar = format_progress_bar(0, 12)
                    lines.append(f"- **{b.get('name')}**: `0.0% (実効0% / 5h生値: {pct:.1f}%)` `[{bar}]`{time_badge}")
                else:
                    bar = format_progress_bar(pct, length=12)
                    lines.append(f"- **{b.get('name')}**: `{pct:.1f}%` `[{bar}]`{time_badge}")
                if desc:
                    lines.append(f"  - _{desc}_")

            # 枯渇済み（残量 0% 表示）はペース分析を出さない
            if w_pacing and w_pacing["remaining_pct"] > 0:
                burn_icon = "🔥" if w_pacing["is_overburning"] else "⏱️"
                eta_h = w_pacing["time_to_empty_hr"]
                eta_str = f"約{eta_h:.1f}時間後" if eta_h < 72 else f"約{eta_h/24:.1f}日後"
                lines.append(f"- **Pacing Analysis**: {burn_icon} `{w_pacing['burn_rate']:.2f}x speed`")
                if w_pacing["is_overburning"]:
                    lines.append(f"  - ⚠️ **枯渇予測 (ETA to 0%)**: **{eta_str}** に全損予定（リセットまで残り {w_pacing['remaining_hours']/24:.1f}日）")
                    lines.append(f"  - 🛡️ **推奨安全ペース**: 1日あたり **~{w_pacing['safe_daily_pct']:.1f}%** 以内に抑制")
            lines.append("")
    else:
        err = agy.get("error", "Unknown error")
        lines.append(f"> ⚠️ Failed to fetch Antigravity usage: `{err}`\n")

    # Cursor section
    lines.append("## Cursor")
    if "planUsage" in cursor:
        plan = cursor["planUsage"]
        auto_used = float(plan.get("autoPercentUsed", 0.0))
        api_used = float(plan.get("apiPercentUsed", 0.0))
        tot_used = float(plan.get("totalPercentUsed", 0.0))

        auto_left = max(0.0, 100.0 - auto_used)
        api_left = max(0.0, 100.0 - api_used)
        tot_left = max(0.0, 100.0 - tot_used)

        lines.append(f"- **Cursor Models (Left)**: `{auto_left:.1f}% left` `[{format_progress_bar(auto_left, 12)}]`")
        lines.append(f"- **Other Models (Left)**: `{api_left:.1f}% left` `[{format_progress_bar(api_left, 12)}]`")
        lines.append(f"- **Total Period Budget (Left)**: `{tot_left:.1f}% left` `[{format_progress_bar(tot_left, 12)}]`")

        cycle_end = cursor.get("billingCycleEnd")
        if cycle_end:
            try:
                dt = datetime.fromtimestamp(int(cycle_end) / 1000)
                lines.append(f"- **Billing Cycle Reset**: `{dt.strftime('%Y-%m-%d %H:%M')}`")
            except Exception:
                pass
        lines.append("")
    else:
        err = cursor.get("error", "Unknown error")
        lines.append(f"> ⚠️ Failed to fetch Cursor usage: `{err}`\n")


    # DeepSeek section
    lines.append("## DeepSeek (OpenCode API)")
    if "balance_infos" in deepseek and deepseek["balance_infos"]:
        b_info = deepseek["balance_infos"][0]
        curr = b_info.get("currency", "USD")
        tot = b_info.get("total_balance", "0.00")
        granted = b_info.get("granted_balance", "0.00")
        topped_up = b_info.get("topped_up_balance", "0.00")
        symbol = "$" if curr == "USD" else "¥"
        avail = "✅ Available" if deepseek.get("is_available") else "❌ Exhausted"

        lines.append(f"- **Status**: {avail}")
        lines.append(f"- **Total Balance**: `{symbol}{tot} {curr}`")
        lines.append(f"  - _Topped-up (Paid): {symbol}{topped_up} / Granted (Trial): {symbol}{granted}_")
        lines.append("")
    elif "error" in deepseek:
        lines.append(f"> ⚠️ DeepSeek: `{deepseek.get('error')}`\n")

    # Claude (Claude Code subscription windows)
    plan_label = "Team" if claude and claude.get("plan") == "team" else "Claude Code"
    lines.append(f"## Claude ({plan_label}){claude_cache_suffix(claude)}")
    if claude and "five_hour" in claude:
        for key, name in (("five_hour", "Session (5h)"), ("seven_day", "Weekly (7d)")):
            bucket = claude.get(key) or {}
            used = bucket.get("used_pct")
            if used is None:
                continue
            left = max(0.0, min(100.0, 100.0 - float(used)))
            rem_time = format_time_remaining(bucket.get("resets_at", ""))
            reset_badge = f" `[リセットまで {rem_time}]`" if rem_time else ""
            lines.append(
                f"- **{name}**: `{left:.1f}% left` `[{format_progress_bar(left, 12)}]`{reset_badge}"
            )
        limits = claude.get("limits") or []
        active = [l.get("kind") for l in limits if l.get("is_active")]
        if active:
            lines.append(f"- **Active limit**: `{', '.join(active)}`")
        lines.append("")
    elif claude and "error" in claude:
        lines.append(f"> ⚠️ Claude: `{claude.get('error')}`\n")
    else:
        lines.append("> ⚠️ Claude: no usage data\n")

    now_str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    lines.append(f"---\n_Last updated: {now_str}_")
    return "\n".join(lines)


def write_runcat_json(payload, dest_path):
    dest_path = os.path.expanduser(dest_path)
    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
    temp_fd, temp_path = tempfile.mkstemp(dir=os.path.dirname(dest_path), prefix="runcat_", suffix=".tmp")
    try:
        with os.fdopen(temp_fd, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2, ensure_ascii=False)
        os.replace(temp_path, dest_path)
    except Exception as e:
        if os.path.exists(temp_path):
            os.remove(temp_path)
        raise e


def check_and_send_critical_notifications(agy):
    """Check if any weekly quota is in a critical burn state and send notification."""
    if "groups" not in agy:
        return
    for g in agy["groups"]:
        g_name = g.get("name", "")
        b_dict = {b.get("window"): b for b in g.get("buckets", [])}
        w_bucket = b_dict.get("weekly")
        if not w_bucket:
            continue
        rem_frac = float(w_bucket.get("remaining_fraction", 1.0))
        rem_pct = int(round(rem_frac * 100))
        pacing = calculate_weekly_pacing(rem_frac, w_bucket.get("reset_time"))
        if pacing and pacing["is_critical"] and rem_pct > 0:
            send_quota_notification(g_name, pacing["burn_rate"], pacing["time_to_empty_hr"], rem_pct)


def main():
    parser = argparse.ArgumentParser(description="Update and view AI quota metrics")
    parser.add_argument("--format", choices=["markdown", "inline", "json", "runcat"], default="markdown",
                        help="Output format (default: markdown)")
    parser.add_argument("--write-runcat", action="store_true", default=True,
                        help="Write JSON payload to RunCat Neo metrics file (default: True)")
    parser.add_argument("--no-write-runcat", dest="write_runcat", action="store_false",
                        help="Do not write to RunCat Neo metrics file")
    parser.add_argument("--runcat-path", default="~/.config/runcat-neo/ai-usage.json",
                        help="Target file path for RunCat Neo JSON")
    parser.add_argument("--notify", action="store_true", default=True,
                        help="Check and trigger macOS notification for critical burn rates (default: True)")
    parser.add_argument("--no-notify", dest="notify", action="store_false",
                        help="Disable desktop notifications")

    args = parser.parse_args()

    agy_bin = find_agy_binary()
    agy = fetch_antigravity_usage(agy_bin)
    cursor = fetch_cursor_usage()
    deepseek = fetch_deepseek_balance()
    claude = fetch_claude_usage()

    if args.notify:
        check_and_send_critical_notifications(agy)

    runcat_payload = build_runcat_payload(agy, cursor, deepseek, claude)

    if args.write_runcat:
        try:
            write_runcat_json(runcat_payload, args.runcat_path)
        except Exception as e:
            sys.stderr.write(f"Warning: Failed to write RunCat JSON: {e}\n")

    if args.format == "markdown":
        print(format_markdown(agy, cursor, deepseek, claude))
    elif args.format == "inline":
        print(format_inline(agy, cursor, deepseek, claude))
    elif args.format == "json":
        print(json.dumps({
            "antigravity": agy,
            "cursor": cursor,
            "deepseek": deepseek,
            "claude": claude,
        }, indent=2, ensure_ascii=False))
    elif args.format == "runcat":
        print(json.dumps(runcat_payload, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
