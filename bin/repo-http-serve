#!/usr/bin/env bash
# 任意ディレクトリを常駐向けに HTTP 配信する汎用サーバ。
# Ctrl+C (SIGINT) は無視。停止は thinkpad-resident stop <name> または SIGTERM。
# 文字化け防止 (UTF-8) とパンくず付きディレクトリ探索機能を内包。
set -euo pipefail

DIR=""
PORT=""
NAME="repo-http"
BIND="${REPO_HTTP_BIND:-0.0.0.0}"

usage() {
  cat <<EOF
Usage: repo-http-serve --dir DIR --port PORT [--name NAME] [--bind ADDR]

Examples:
  repo-http-serve --dir ~/brain/research-brain --port 8766 --name http-brain
  repo-http-serve --dir ~/projects/hybrid-workflow-sandbox --port 8765 --name http-sandbox

Env:
  REPO_HTTP_BIND   default bind address (default: 0.0.0.0)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) DIR="${2:-}"; shift 2 ;;
    --port) PORT="${2:-}"; shift 2 ;;
    --name) NAME="${2:-}"; shift 2 ;;
    --bind) BIND="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "unknown arg: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$DIR" || -z "$PORT" ]]; then
  usage >&2
  exit 1
fi
if [[ ! -d "$DIR" ]]; then
  echo "error: not a directory: $DIR" >&2
  exit 1
fi

TS_IP="$(tailscale ip -4 2>/dev/null || true)"

echo "[$NAME] Serving $DIR on port $PORT (bind $BIND)"
echo "  http://127.0.0.1:${PORT}/"
echo "  http://localhost:${PORT}/"
if [[ -n "${TS_IP}" ]]; then
  echo "  http://${TS_IP}:${PORT}/"
fi
echo "Note: Ctrl+C ignored. Detach: Ctrl-b d. Stop: thinkpad-resident stop ${NAME}"

cd "$DIR"
trap '' INT
trap 'exit 0' TERM HUP

python3 - "$PORT" "$BIND" <<'PY' &
import html
import http.server
import io
import os
import sys
import urllib.parse

class RobustHandler(http.server.SimpleHTTPRequestHandler):
    extensions_map = {
        **http.server.SimpleHTTPRequestHandler.extensions_map,
        '.md': 'text/plain; charset=utf-8',
        '.html': 'text/html; charset=utf-8',
        '.txt': 'text/plain; charset=utf-8',
        '.json': 'application/json; charset=utf-8',
    }

    def list_directory(self, path):
        try:
            entries = list(os.scandir(path))
        except OSError:
            self.send_error(404, "No permission to list directory")
            return None

        dirs = []
        files = []
        for e in entries:
            if e.name.startswith('.'):
                continue
            try:
                if e.is_dir(follow_symlinks=False):
                    dirs.append(e.name + '/')
                else:
                    files.append(e.name)
            except OSError:
                continue

        dirs.sort(key=str.lower)
        files.sort(key=str.lower)

        # パンくずナビゲーション用のパーツ
        rel_path = urllib.parse.unquote(self.path).strip('/')
        parts = [p for p in rel_path.split('/') if p]

        breadcrumb_html = ['<a href="/">root</a>']
        cur = ""
        for p in parts:
            cur += "/" + urllib.parse.quote(p)
            breadcrumb_html.append(f'<a href="{cur}/">{html.escape(p)}</a>')
        breadcrumb_str = " / ".join(breadcrumb_html)

        title = html.escape(f"/{rel_path}" if rel_path else "/")

        rows = []
        if parts:
            parent = "/" + "/".join(urllib.parse.quote(p) for p in parts[:-1])
            if not parent.endswith('/'):
                parent += "/"
            rows.append(f'<tr><td>📁</td><td><a href="{parent}">.. (parent directory)</a></td><td>-</td></tr>')

        for d in dirs:
            safe_d = html.escape(d)
            rows.append(f'<tr><td>📁</td><td><a href="{urllib.parse.quote(d)}">{safe_d}</a></td><td>-</td></tr>')

        for f in files:
            safe_f = html.escape(f)
            try:
                sz = os.path.getsize(os.path.join(path, f))
                if sz < 1024:
                    sz_str = f"{sz} B"
                elif sz < 1024 * 1024:
                    sz_str = f"{sz/1024:.1f} KB"
                else:
                    sz_str = f"{sz/(1024*1024):.1f} MB"
            except OSError:
                sz_str = "-"

            icon = "📄"
            if f.endswith('.md'):
                icon = "📝"
            elif f.endswith('.html'):
                icon = "🌐"
            elif f.endswith('.pdf'):
                icon = "📕"
            elif f.endswith(('.png', '.jpg', '.jpeg', '.svg')):
                icon = "🖼️"
            rows.append(f'<tr><td>{icon}</td><td><a href="{urllib.parse.quote(f)}">{safe_f}</a></td><td>{sz_str}</td></tr>')

        html_content = f"""<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<style>
  body {{ font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 2rem auto; max-width: 900px; padding: 0 1rem; color: #1f2328; background: #fff; line-height: 1.5; }}
  @media (prefers-color-scheme: dark) {{
    body {{ background: #0d1117; color: #e6edf3; }}
    a {{ color: #58a6ff !important; }}
    table tr:hover {{ background: #161b22 !important; }}
    th, td {{ border-color: #30363d !important; }}
    .breadcrumb {{ border-color: #30363d !important; }}
  }}
  .breadcrumb {{ font-size: 1.1rem; padding: 0.5rem 0; margin-bottom: 1rem; border-bottom: 1px solid #d0d7de; }}
  .breadcrumb a {{ color: #0969da; text-decoration: none; font-weight: 500; }}
  .breadcrumb a:hover {{ text-decoration: underline; }}
  table {{ width: 100%; border-collapse: collapse; margin-top: 0.5rem; }}
  th, td {{ padding: 0.5rem; text-align: left; border-bottom: 1px solid #ebf0f4; }}
  td:first-child {{ width: 2rem; text-align: center; }}
  td:last-child {{ width: 6rem; text-align: right; color: #656d76; font-size: 0.85rem; }}
  a {{ color: #0969da; text-decoration: none; word-break: break-all; }}
  a:hover {{ text-decoration: underline; }}
  table tr:hover {{ background: #f6f8fa; }}
</style>
</head>
<body>
<div class="breadcrumb">{breadcrumb_str}</div>
<table>
  <thead><tr><th></th><th>Name</th><th>Size</th></tr></thead>
  <tbody>
    {''.join(rows)}
  </tbody>
</table>
</body>
</html>"""
        encoded = html_content.encode('utf-8')
        f = io.BytesIO()
        f.write(encoded)
        f.seek(0)
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        return f

if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8000
    bind = sys.argv[2] if len(sys.argv) > 2 else "0.0.0.0"
    server_address = (bind, port)
    http.server.ThreadingHTTPServer.allow_reuse_address = True
    httpd = http.server.ThreadingHTTPServer(server_address, RobustHandler)
    httpd.serve_forever()
PY
SERVER_PID=$!
trap 'kill "$SERVER_PID" 2>/dev/null || true; wait "$SERVER_PID" 2>/dev/null || true; exit 0' TERM HUP
wait "$SERVER_PID"
