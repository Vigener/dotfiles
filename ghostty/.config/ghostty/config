# Ghostty = herdr 専用の外側端末（MBA）。
# 素のシェル / HPC SSH は Warp。thinkpad 確認は英数+N で2枚目を開く。
#
# initial-command は機種ローカル:
#   ~/.config/ghostty/config.local
# MBA では link-dotfiles-macos.sh が example から一度だけ作る。
#
# prefix は ctrl+space (\x00)。unbind して通すだけでは Ctrl+Tab が
# 区別不能（素の Tab と同じ）なので、Cmd+T と同じく text: で送る。

config-file = ?~/.config/ghostty/config.local

# 英数+T → Cmd+T → herdr new_tab (prefix+c)
keybind = cmd+t=text:\x00c

# 英数+W → Cmd+W → herdr close_pane (prefix+x)。タブごと消さない。
keybind = cmd+w=text:\x00x

# 英数+Ctrl+Q → Ctrl+Q → herdr detach (prefix+q)。Cmd+Q（アプリ終了）は触らない。
keybind = ctrl+q=text:\x00q

# Ctrl+Tab / Ctrl+Shift+Tab → herdr next/previous tab (prefix+n / prefix+p)
keybind = ctrl+tab=text:\x00n
keybind = ctrl+shift+tab=text:\x00p
